{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AAXSysPulse-Guide",
  "version": "0.7.1",
  "identifier": "com.aaxsyspulse.guide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "guide",
        "title": "AAXSysPulse 引导",
        "width": 680,
        "height": 560,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/AAXSysPulse.exe": "AAXSysPulse.exe",
      "resources/WinRing0x64.sys": "WinRing0x64.sys"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
